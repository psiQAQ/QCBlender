.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
# Preserve fixed upstream scientific fixtures and their checksum identities byte for byte.
tests/data/** -text -diff
tests/data/distribution/*.md text eol=lf diff
tests/data/local-inputs.json text eol=lf diff
tests/data/visual-baseline/*.json text eol=lf diff
# Keep relocated scientific inputs byte-identical on every checkout.
validation/shared/data/public/** -text -diff
validation/shared/data/public/README.md text eol=lf diff
validation/shared/data/regression/** -text -diff
validation/shared/data/regression/visual-baseline/*.json text eol=lf diff
validation/shared/data/complex-example-sources.json -text -diff
validation/shared/data/local-log-downloads.json -text -diff
# Preserve the upstream GNU license text, including its original final blank line.
LICENSE -text whitespace=-blank-at-eof
# Keep relocated upstream license originals byte-identical on every checkout.
modules/licenses/** -text whitespace=-blank-at-eof

# Preserve relocated frozen manifests and historical machine reports byte for byte.
validation/agent/acceptance/*.json -text
validation/agent/v1-acceptance/tutorial-samples.json -text
# This historical report was saved with CRLF; preserve its original byte identity.
validation/agent/acceptance/alpha-readiness-delivery.json whitespace=cr-at-eol

---
interface Props { href?: string; }
const { href } = Astro.props;
---
{href ? <a class="qc-brand" href={href} aria-label="QCBlender"><svg viewBox="0 0 36 36" fill="none" aria-hidden="true"><ellipse cx="18" cy="18" rx="16" ry="7" transform="rotate(-40 18 18)"/><ellipse cx="18" cy="18" rx="16" ry="7" transform="rotate(40 18 18)"/><circle cx="18" cy="18" r="3"/></svg><span translate="no">QCBlender<span class="brand-dot">.</span></span></a> : <span class="qc-brand"><svg viewBox="0 0 36 36" fill="none" aria-hidden="true"><ellipse cx="18" cy="18" rx="16" ry="7" transform="rotate(-40 18 18)"/><ellipse cx="18" cy="18" rx="16" ry="7" transform="rotate(40 18 18)"/><circle cx="18" cy="18" r="3"/></svg><span translate="no">QCBlender<span class="brand-dot">.</span></span></span>}
<style>
  .qc-brand { display: inline-flex; align-items: center; gap: .65rem; color: inherit; text-decoration: none; font-family: var(--qc-font, system-ui, sans-serif); font-size: 1.3rem; font-weight: 750; letter-spacing: -.055em; white-space: nowrap; }
  svg { width: 2rem; height: 2rem; flex-shrink: 0; stroke: var(--qc-accent, #078799); stroke-width: 1.25; }
  circle { fill: var(--qc-accent, #078799); stroke: none; }
  .brand-dot { color: var(--qc-accent, #078799); }
</style>

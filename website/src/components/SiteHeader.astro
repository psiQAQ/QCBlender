---
import Brand from './Brand.astro';
import ThemeSelect from './ThemeSelect.astro';
import { copy, repository, sitePath, type Locale } from '../data/copy';
interface Props { locale: Locale; page?: 'home' | 'downloads'; }
const { locale, page = 'home' } = Astro.props;
const t = copy[locale];
const home = sitePath(locale === 'en' ? 'en/' : '');
const downloads = sitePath(locale === 'en' ? 'en/downloads/' : 'downloads/');
const alternate = sitePath(locale === 'en' ? (page === 'downloads' ? 'downloads/' : '') : (page === 'downloads' ? 'en/downloads/' : 'en/'));
const links = [
  { label: t.examples, href: `${home}#explore` },
  { label: t.tutorial, href: sitePath('docs/getting-started/') },
  { label: t.downloads, href: downloads, active: page === 'downloads' },
];
---
<header class="site-header">
  <div class="header-inner">
    <Brand href={home} />
    <nav class="desktop-nav" aria-label={t.navLabel}>{links.map(link => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}</nav>
    <div class="header-tools">
      <ThemeSelect locale={locale} />
      <a class="language-link" href={alternate} lang={locale === 'en' ? 'zh-CN' : 'en'} hreflang={locale === 'en' ? 'zh-CN' : 'en'}>{t.otherLanguage}</a>
      <a class="github-link" href={repository} aria-label="QCBlender GitHub"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.13c-3.09.67-3.74-1.31-3.74-1.31-.51-1.29-1.24-1.63-1.24-1.63-1.01-.69.08-.68.08-.68 1.11.08 1.7 1.14 1.7 1.14.99 1.7 2.6 1.21 3.23.92.1-.72.39-1.21.7-1.49-2.47-.28-5.07-1.24-5.07-5.5 0-1.21.43-2.2 1.14-2.98-.11-.28-.5-1.41.11-2.94 0 0 .93-.3 3.05 1.14a10.7 10.7 0 0 1 5.56 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.22 2.66.11 2.94.71.78 1.14 1.77 1.14 2.98 0 4.27-2.6 5.21-5.08 5.49.4.35.75 1.02.75 2.06v3.23c0 .3.2.65.76.54A11.1 11.1 0 0 0 12 .9Z"/></svg></a>
      <details class="mobile-menu"><summary aria-label={t.menu}><svg viewBox="0 0 24 24" width="23" height="23" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></summary><nav aria-label={t.navLabel}>{links.map(link => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}<a href={repository}>{t.source} ↗</a></nav></details>
    </div>
  </div>
</header>

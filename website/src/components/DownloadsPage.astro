---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from './Arrow.astro';
import { copy, publicSamples, releases, repository, sitePath, type Locale } from '../data/copy';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
---
<SiteLayout locale={locale} page="downloads">
  <section class="download-hero container" aria-labelledby="download-title"><p class="eyebrow"><span class="signal-dot" />{t.downloadEyebrow}</p><h1 id="download-title">{t.downloadHeadline}</h1><p>{t.downloadIntro}</p></section>
  <section class="download-materials container" aria-label={t.downloadTitle}>
    <article class="extension-material">
      <p class="eyebrow">{t.packageLabel}</p>
      <div class="material-title"><h2>{t.packageTitle}</h2><span class="alpha-badge">ALPHA</span></div>
      <p class="release-status"><span aria-hidden="true" />{t.unavailable}</p>
      <p class="material-body">{t.packageBody}</p>
      <div class="button-row"><a class="button button-outline" href={releases}>{t.releasesLink}<Arrow external /></a><a class="text-link" href={`${repository}/blob/main/docs/DEVELOPMENT.md`}>{t.buildLink}<Arrow external /></a></div>
      <p class="material-note">{t.packageNote}</p>
    </article>
    <article class="samples-material">
      <div><p class="eyebrow">{t.samplesLabel}</p><h2>{t.samplesTitle}</h2><p class="material-body">{t.samplesBody}</p></div>
      <div class="sample-download"><span class="file-glyph" aria-hidden="true"><svg viewBox="0 0 36 44" width="30" height="37" fill="none"><path d="M3 1h20l10 10v32H3V1Z" stroke="currentColor" stroke-width="1.5"/><path d="M23 1v11h10M18 18v15m-6-6 6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span><div><h3>{t.samplesName}</h3><p>{t.samplesSize}</p></div><a class="button button-primary" href={sitePath(publicSamples)} download>{t.samplesLink}<Arrow /></a></div>
      <p class="material-note">{t.samplesNote}</p>
    </article>
  </section>
  <section class="installation-section container section-space" aria-labelledby="installation-title"><p class="eyebrow">{locale === 'zh' ? '安装顺序' : 'INSTALLATION'}</p><h2 id="installation-title">{t.installTitle}</h2><ol class="installation-steps">{t.installation.map((step, index) => <li><span class="installation-index">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}</ol><p class="scientific-note">{t.installationNote}</p></section>
  <section class="compatibility-section container section-space download-compatibility" aria-labelledby="requirements-title"><div><p class="eyebrow">{t.compatibilityLabel}</p><h2 id="requirements-title">{locale === 'zh' ? '兼容范围与计算边界' : 'Compatibility & calculation scope'}</h2><p class="section-body">{t.compatibilityNote}</p></div><div class="compatibility-detail"><dl>{t.compatibilityRows.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div></section>
  <section class="tutorial-cta container" aria-labelledby="download-tutorial-title"><div><p class="eyebrow">{t.ctaLabel}</p><h2 id="download-tutorial-title">{t.ctaTitle}</h2><p>{t.ctaBody}</p></div><a class="button button-primary" href={sitePath('docs/getting-started/')}>{t.ctaLink}<Arrow /></a><span class="cta-mark" aria-hidden="true">ψ</span></section>
</SiteLayout>

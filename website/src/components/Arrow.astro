---
interface Props { external?: boolean; }
const { external = false } = Astro.props;
---
<svg class="arrow-icon" viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true"><path d={external ? 'M5 15 15 5M5 5h10v10' : 'M3 10h13M11 5l5 5-5 5'} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
<style>.arrow-icon { display: inline-block; flex-shrink: 0; vertical-align: middle; }</style>
